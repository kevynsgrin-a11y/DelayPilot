#
# DelayPilot — external inputs.  Owner: principal-architect.
#
# Copy to `.env` for build-time variables, and to `apps/edge/.dev.vars` for Worker runtime values.
# Both are gitignored.  This file carries NAMES and ACTIVATION STEPS ONLY — never a real value.
# AGENTS.md §2: secrets live in Wrangler secrets or the deployment secret store, never in source.
#
# Every variable below is an external input that cannot be produced from code.  Each one has a
# complete adapter and a fail-closed production path, so the build and the demo experience work
# without any of them (docs/BUILD_PLAN.md §7).
#

# =============================================================================================
# REQUIRED FOR A PRODUCTION DEPLOY
# =============================================================================================

# Canonical public origin, no trailing slash.  Used for canonical URLs, sitemaps, and OG tags.
# The production build FAILS if this is missing or still an example value (DIRECTIVE.md §19) —
# an invented domain in a canonical tag is worse than no canonical tag.
PUBLIC_SITE_URL=https://example.invalid

# Cloudflare account and deploy credentials.  Used by `wrangler deploy` and by CI.
# Create the token at: Cloudflare dashboard → My Profile → API Tokens → Create Custom Token.
# Scope it to THIS account and THIS zone only, with: Workers Scripts:Edit, D1:Edit,
# Workers KV Storage:Edit, Queues:Edit, Workflows:Edit, Workers Routes:Edit, DNS:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# =============================================================================================
# WORKER RUNTIME SECRETS  (set with: wrangler secret put <NAME>  — locally: apps/edge/.dev.vars)
# =============================================================================================

# Turnstile, protecting flight lookup and magic-link requests from automated abuse.
# Create at: Cloudflare dashboard → Turnstile → Add Site.  Add localhost for local development.
# The site key is public; it is listed here because it is an external input with no known value.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application cryptography (DIRECTIVE.md §11, owner: security-privacy-engineer).
# Generate each independently — never reuse one value across two of them:
#   openssl rand -base64 32
# ENCRYPTION_PRIMARY_KEY  AES-GCM key for encrypted application fields (e.g. stored email).
# HMAC_IDENTIFIER_KEY     HMAC-SHA-256 key for normalized lookup identifiers and alert
#                         fingerprints.  Rotating this invalidates deduplication history.
# SESSION_SIGNING_KEY     Session cookie signing.  Rotating this logs everyone out.
ENCRYPTION_PRIMARY_KEY=
HMAC_IDENTIFIER_KEY=
SESSION_SIGNING_KEY=

# =============================================================================================
# FLIGHT DATA  (Phase 4 — integrations-provider-engineer)
# =============================================================================================
#
# DelayPilot runs on the deterministic fixture provider until BOTH a credential AND a licence
# policy record exist.  A credential alone is not sufficient: readiness fails closed unless the
# provider has an approved ProviderLicensePolicy covering consumer display, caching, persistence,
# and derivative use (DIRECTIVE.md §10.6, docs/PROVIDER_LICENSING.md).
#
# Selects the active provider: fixture | flightaware | cirium | oag
FLIGHT_PROVIDER=fixture

# FlightAware AeroAPI — requires a commercial tier permitting B2C display and storage.
AEROAPI_KEY=

# Cirium / OAG — enable only with credentials and a licence recorded in docs/PROVIDER_LICENSING.md.
CIRIUM_CLIENT_ID=
CIRIUM_CLIENT_SECRET=
OAG_API_KEY=

# AviationWeather.gov requires no key, but does require an identifying User-Agent
# (DIRECTIVE.md §11.1).  Set this to a real contact address before enabling weather in production.
AVIATIONWEATHER_USER_AGENT=DelayPilot/0.1 (contact@example.invalid)

# =============================================================================================
# BILLING  (Phase 8 — billing-entitlements-engineer)
# =============================================================================================
#
# With these unset, purchase controls are hidden in production and the app shows the designed
# "billing not configured" state rather than a broken checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIP_PASS=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_FAMILY_ANNUAL=

# =============================================================================================
# NOTIFICATIONS  (Phase 8 — workflows-notifications-engineer)
# =============================================================================================

# Transactional email.  Operational alerts are separate from marketing consent (DIRECTIVE.md §16).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=

# Web push (VAPID).  Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.invalid

# SMS is implemented but DISABLED at launch (DIRECTIVE.md §16.1).  Leave blank.
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=

# =============================================================================================
# MONETIZATION  (Phase 11 — monetization-partnerships-engineer)
# =============================================================================================
#
# The AdSense publisher id is already committed in apps/web/public/ads.txt.  Slot ids are not
# invented: an unconfigured slot collapses without leaving a hole, and ads never load before
# consent.  Paid tiers are ad-free regardless of these values.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_GUIDE_MID=
ADSENSE_SLOT_GUIDE_END=
ADSENSE_SLOT_TRIP_RESULT=

# Consent management platform.  Ads and analytics stay off until consent is recorded.
CMP_PROJECT_ID=

# Affiliate partners stay DISABLED until a real agreement and URL exist (DIRECTIVE.md §20).
# Registry lives in data/affiliates/; these are the credentials it resolves against.
AFFILIATE_ESIM_ID=
AFFILIATE_LOUNGE_ID=
AFFILIATE_HOTEL_ID=

# =============================================================================================
# SEO VERIFICATION  (Phase 11 — seo-engineer)
# =============================================================================================
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

---
/**
 * The build-time SVG route globe — ADR 0003 rule 2b and rule 6, Option A.
 *
 * An orthographic wireframe generated by `scripts/assets/build-globe.mjs`, inlined so the CSS arc
 * draw-in can reach `#routes path` and so the stroke inherits the theme. It is `aria-hidden`,
 * carries no text and no data, has no coastline, no border, no city dot and no airport code, and
 * cycles once on entry within `--motion-ambient-cycle`.
 *
 * THE CAPTION IS NOT OPTIONAL AND IT IS NOT INSIDE THE SVG. ADR 0003 rule 6 requires the embedding
 * page to carry, as visible page copy, exactly:
 *
 *     Illustrative route lines — not live traffic.
 *
 * A caption inside an `aria-hidden` decorative graphic is a caption nobody reads
 * (`scripts/assets/MOTIFS.md §3.4`), so it is a `<figcaption>` here, and
 * `apps/web/scripts/verify-dist.mjs` fails the build on any page that inlines the globe without it.
 *
 * WHY IT IS NOT `role="img"` WITH A DESCRIPTION. It depicts nothing. Giving a decorative texture an
 * accessible name adds noise to a screen reader for zero information; the sentence a reader needs
 * — that these lines are illustrative — is in the caption, where a sighted reader needs it too.
 */
import InlineSvg from './InlineSvg.astro'
import { home } from '../lib/copy/home.ts'
---

<figure class="dpx-globe-figure">
  <InlineSvg src="brand/motifs/route-globe.svg" class="dpx-globe" decorative />
  <figcaption class="dpx-globe-figure__caption">{home.hero.motifCaption}</figcaption>
</figure>

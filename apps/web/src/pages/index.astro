---
/**
 * Homepage.
 *
 * The full homepage in DIRECTIVE.md section 18.3 — hero lookup, demo result, connection-risk and
 * passenger-rights explainers, pricing, source strip — is Phase 10 and belongs to
 * frontend-ui-engineer. This page carries only statements that are true today.
 *
 * It deliberately contains no flight-lookup control, because the lookup it would open does not
 * exist yet, and a control that does nothing is a dead control (AGENTS.md section 1.6). For the
 * same reason there is no pricing section (no billing exists), no demo flight result (every flight
 * number, airline, gate and time in design/v0-preview/lib/demo.ts is generated fiction, and two of
 * its airline codes collide with live IATA designators), and no statistic of any kind.
 *
 * What it does instead is state the operating rules the product is actually built on. Those are
 * true today, they are enforced in code and in AGENTS.md, and they are the reason to trust the
 * thing when it does ship.
 */
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'DelayPilot — Stay ahead of flight disruptions'
const description =
  'Track a flight, understand connection risk, and see the refund, care, and rebooking rules that may apply.'

/** The six-value provenance vocabulary is fixed by AGENTS.md section 1.2. It is not paraphrasable. */
const provenance = [
  {
    label: 'Live',
    meaning: 'A licensed provider returned a fresh response within its freshness threshold.',
  },
  {
    label: 'Cached',
    meaning: 'A prior licensed response, still inside the permitted cache window.',
  },
  {
    label: 'Stale',
    meaning: 'Past the normal freshness threshold, still shown — and shown as stale.',
  },
  { label: 'Demo', meaning: 'Fixture data, always labelled “Demo data — not a live flight.”' },
  {
    label: 'Unavailable',
    meaning: 'No trustworthy response exists. The answer is unknown, and says so.',
  },
  {
    label: 'Heuristic risk band',
    meaning: 'A qualitative band. No calibrated model is deployed, so no percentage is shown.',
  },
]

const commitments = [
  {
    heading: 'No booking reference. Ever.',
    body: 'DelayPilot never asks for a PNR or record locator — not as an input, not in a URL, not in a log. It is not a field anywhere in the product.',
  },
  {
    heading: 'Every datum carries its source',
    body: 'Where a value came from and how old it is travels with it from the provider all the way to the pixel. A number with no provenance does not get displayed.',
  },
  {
    heading: '“May apply”, never “you are owed”',
    body: 'Passenger-rights output is an informational estimate tied to a dated, versioned rule set with links to the official source. It is not a determination, and not legal advice.',
  },
  {
    heading: 'Unknown is a designed answer',
    body: 'When no trustworthy source has answered, the interface says so. It does not fill the gap with a plausible guess, a blank, or a zero.',
  },
]
---

<BaseLayout title={title} description={description} nav="home">
  <section class="hero">
    <h1>Stay ahead of flight disruptions.</h1>

    <p class="lede">
      Track a flight, understand connection risk, and see the refund, care, and rebooking rules that
      may apply—before airport chaos makes the decision for you.
    </p>

    <ul class="trust-line">
      <li>Source-linked status</li>
      <li>Versioned passenger-rights rules</li>
      <li>No booking code required</li>
    </ul>
  </section>

  <section class="section">
    <h2>How this site handles uncertainty</h2>

    <p class="section__intro">
      Every piece of flight information DelayPilot shows carries where it came from and how old it
      is. These six labels are the entire vocabulary — there are no synonyms, and none of them is
      ever omitted to make a screen look tidier.
    </p>

    <dl class="card-grid">
      {
        provenance.map((item) => (
          <div class="card">
            <dt>
              <h3>{item.label}</h3>
            </dt>
            <dd style="margin: 0;">
              <p>{item.meaning}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <h2>What DelayPilot will not do</h2>

    <p class="section__intro">
      People read a tool like this while standing at a gate, tired, about to make an expensive and
      irreversible decision. These are the rules the product is built under, and they are enforced
      in the codebase rather than promised in marketing copy.
    </p>

    <div class="card-grid">
      {
        commitments.map((item) => (
          <article class="card">
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2>Where the build is today</h2>

    <div class="prose">
      <p>
        DelayPilot is under construction and this page is the honest state of it. There is no flight
        lookup yet, no account, and no live provider connected — so rather than show a demo flight
        with invented times and gates, the site shows nothing it cannot source.
      </p>
      <p>
        <span class="chip chip--unavailable"><span class="chip__dot"></span>Unavailable</span> is the
        label that applies to live flight data right now, and it will keep applying until a licensed provider
        is connected under a recorded licence.
      </p>
    </div>
  </section>
</BaseLayout>

---
/**
 * The homepage, in the `DIRECTIVE.md §18.3` order, section for section.
 *
 *   compact header → hero with primary lookup → trust line and source/freshness explanation →
 *   interactive demo result → "What DelayPilot tells you" → connection-risk explainer →
 *   passenger-rights explainer → monitoring/alert demonstration → [pricing cards] →
 *   source and methodology strip → selected guides → [affiliate module] → footer
 *
 * TWO SECTIONS ARE DELIBERATELY ABSENT, and their absence is the honest state rather than an
 * oversight:
 *
 * · **Pricing cards.** Billing is Phase 8. No plan, no price and no purchase path exists, and a
 *   price with nothing behind it is a promise the product cannot keep (`AGENTS.md §1.6`). A
 *   "billing not configured" band on a marketing homepage would be worse: it advertises an absence.
 * · **The affiliate module.** No agreement exists with any partner, and `DIRECTIVE.md §20` disables
 *   every affiliate category until one does. An empty disclosed module is still a module.
 *
 * NO AD IS PLACED. The `§20` permitted homepage position is after the complete demo and the first
 * explanatory section; it is marked in a comment at exactly that point and handed to
 * `monetization-partnerships-engineer`. Nothing is placed above or inside the lookup, ever.
 *
 * SELECTED GUIDES RENDERS ONLY IF A GUIDE IS SERVED. With none, the section is omitted entirely —
 * not rendered as an empty state, because an empty "Guides" heading on a homepage advertises
 * content that does not exist.
 *
 * MOTION: two ambient motifs (the hero operations-desk backdrop and the route globe — ADR 0003
 * rule 2b's cap, exactly), CSS scroll-driven reveals on the marketing sections only, and the
 * scroll-scrubbed chronology. Nothing inside the demo cockpit moves.
 */
import { Card, ProvenanceChip, StatusPill } from '@delaypilot/ui'
import { severityToStatusTone } from '@delaypilot/ui'

import BaseLayout from '../layouts/BaseLayout.astro'
import Chronology from '../components/Chronology.astro'
import DemoCockpit from '../components/DemoCockpit.astro'
import HeroMotif from '../components/HeroMotif.astro'
import LookupForm from '../components/LookupForm.astro'
import ProvenanceLegend from '../components/ProvenanceLegend.astro'
import RouteGlobe from '../components/RouteGlobe.astro'
import Section from '../components/Section.astro'
import { contactRoutesEnabled, servedGuides } from '../components/routes.ts'

import { chronology } from '../lib/copy/chronology.ts'
import { cockpit } from '../lib/copy/cockpit.ts'
import { home } from '../lib/copy/home.ts'
import { pages } from '../lib/copy/pages.ts'

const guides = await servedGuides()

/**
 * `/accessibility/` is emitted only when `PUBLIC_CONTACT_EMAIL` is configured, so the methodology
 * strip drops it when it is not. A strip link to a route the build did not emit is a dead link.
 */
const strip = Object.entries(home.methodologyStrip.links).filter(
  ([href]) => href !== '/accessibility/' || contactRoutesEnabled,
)

const severityTone = severityToStatusTone
---

<BaseLayout title={pages.home.title} description={pages.home.description} nav="home">
  {
    /* 2. Hero with the primary lookup. The lookup is visible at 375px without scrolling past
       marketing: the heading, the support line and the form are the first three blocks. */
  }
  <section class="dpx-hero" aria-labelledby="hero-title">
    <HeroMotif />
    <div class="dpx-shell">
      <div class="dpx-hero__grid">
        <div>
          <h1 class="dpx-hero__title" id="hero-title">{home.hero.heading}</h1>
          <p class="dpx-hero__support">{home.hero.intro}</p>

          <p class="dpx-hero__ctas">
            <a class="dp-button dp-button--primary" href="#track-a-flight" data-dp-focus-lookup>
              {home.ctas.primary}
            </a>
            <a class="dp-button dp-button--secondary" href="#demonstration">
              {home.ctas.secondary}
            </a>
          </p>
        </div>

        <div>
          <LookupForm headingLevel={2} />
        </div>
      </div>

      {
        /* The trust line and the availability note sit BELOW the grid, not above the form.
           `§18.7` requires the primary lookup to be visible at 375px without scrolling past
           marketing, and every sentence placed before it on a phone pushes it further down. On a
           wide viewport the row spans both columns and reads as a caption under the pair. */
      }
      <ul class="dpx-trust" aria-label={home.hero.trustLineLabel}>
        {home.trustLine.map((item) => <li class="dpx-trust__item">{item}</li>)}
      </ul>

      <p class="dpx-lookup__note dpx-hero__availability">{home.hero.availabilityNote}</p>
    </div>
  </section>

  {/* 3. Trust line and source/freshness explanation — the six labels, as the real chips. */}
  <Section heading={home.sources.heading} intro={home.sources.intro} id="provenance" reveal>
    <ProvenanceLegend />
    <p class="dpx-lookup__note">{home.sources.disclaimer}</p>
  </Section>

  {/* 4. The interactive demo result. */}
  <Section heading={home.demo.heading} intro={home.demo.intro} id="demonstration">
    <DemoCockpit />
  </Section>

  {/* 5. What DelayPilot tells you — exactly four tiles. */}
  <Section heading={home.tells.heading} intro={home.tells.intro} id="what-it-tells-you" reveal>
    <ul class="dpx-tiles dpx-tiles--four">
      {
        home.tells.items.map((tile) => (
          <li class="dpx-tile">
            <h3 class="dpx-tile__title">{tile.title}</h3>
            <p class="dpx-tile__body">{tile.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    /*
    §20 PERMITTED HOMEPAGE AD POSITION, LEFT DELIBERATELY EMPTY.
    "Homepage after the complete demo and first explanatory section" — that is this point, and no
    other. Nothing is placed in this wave: no consent platform, no slot id and no ad code exists.
    `monetization-partnerships-engineer` fills it through `AdSlotShell` with
    `placement="home_after_demo_and_first_explainer"`. It may never move above the demo, into the
    hero, or anywhere near the lookup form.
  */
  }

  {/* 6. Connection-risk explainer. */}
  <Section
    heading={home.connection.heading}
    intro={home.connection.intro}
    id="connection-risk"
    reveal
  >
    <dl class="dpx-definitions">
      {
        home.connection.terms.map((term) => (
          <div class="dpx-definition">
            <dt class="dpx-definition__term">{term.term}</dt>
            <dd class="dpx-definition__body">{term.body}</dd>
          </div>
        ))
      }
    </dl>

    <h3 class="dpx-section__title">{home.connection.derivationHeading}</h3>
    <p class="dpx-section__intro">{home.connection.derivationIntro}</p>
    <dl class="dpx-definitions">
      {
        home.connection.derivations.map((term) => (
          <div class="dpx-definition">
            <dt class="dpx-definition__term">{term.term}</dt>
            <dd class="dpx-definition__body">{term.body}</dd>
          </div>
        ))
      }
    </dl>

    <h3 class="dpx-section__title">{home.connection.selfTransferHeading}</h3>
    <p class="dpx-section__intro">{home.connection.selfTransfer}</p>
    <p class="dpx-lookup__note">{home.connection.disclaimer}</p>
  </Section>

  {/* 7. Passenger-rights explainer — the five permitted statuses, rendered as the real pills. */}
  <Section heading={home.rights.heading} intro={home.rights.intro} id="passenger-rights" reveal>
    <h3 class="dpx-section__title">{home.rights.statusHeading}</h3>
    <ul class="dpx-tiles">
      {
        home.rights.statuses.map((entry) => (
          <li class="dpx-tile">
            <StatusPill
              status={
                entry.status === 'likely_applies'
                  ? 'safe'
                  : entry.status === 'may_apply'
                    ? 'watch'
                    : 'unknown'
              }
              label={entry.label}
            />
            <p class="dpx-tile__body">{entry.body}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="dpx-section__title">{home.rights.disciplineHeading}</h3>
    <p class="dpx-section__intro">{home.rights.discipline}</p>

    <h3 class="dpx-section__title">{home.rights.currentVsFutureHeading}</h3>
    <p class="dpx-section__intro">{home.rights.currentVsFuture}</p>

    <p class="dpx-lookup__note">{home.rights.disclaimer}</p>
  </Section>

  {
    /* 8. Monitoring and alert demonstration. The §28 alert timeline itself is rendered inside the
       demo cockpit above, where a timeline belongs beside the itinerary it describes; this section
       is the severity ladder it climbs and the chronology it moves through. */
  }
  <Section heading={home.monitoring.heading} intro={home.monitoring.intro} id="monitoring" reveal>
    <ul class="dpx-tiles dpx-tiles--four">
      {
        home.monitoring.severities.map((entry) => (
          <li class="dpx-tile">
            <StatusPill
              status={severityTone[entry.severity as keyof typeof severityTone]}
              label={entry.label}
            />
            <p class="dpx-tile__body">{entry.body}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="dpx-section__title">{chronology.heading}</h3>
    <p class="dpx-section__intro">{chronology.intro}</p>
    <Chronology />

    <p class="dpx-lookup__note">{home.monitoring.contents}</p>
    <p class="dpx-lookup__note">{home.monitoring.notConnected}</p>
  </Section>

  {/* 9. Pricing cards — OMITTED. See the docblock at the top of this file. */}

  {/* 10. Source and methodology strip, with the route globe and its required caption. */}
  <Section
    heading={home.methodologyStrip.heading}
    intro={home.methodologyStrip.intro}
    id="methodology-strip"
    reveal
  >
    <RouteGlobe />
    <ul class="dpx-link-strip">
      {
        strip.map(([href, label]) => (
          <li>
            <a class="dpx-link-strip__link" href={href}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 11. Selected guides — rendered only when at least one guide entry is served. */}
  {
    guides.length > 0 && (
      <Section heading={home.guidesStrip.heading} intro={home.guidesStrip.intro} id="guides" reveal>
        <ul class="dpx-card-list">
          {guides.map((entry) => (
            <li>
              <Card as="article">
                <h3 class="dpx-entry-card__title">
                  <a href={`/guides/${entry.id}/`}>{entry.data.title}</a>
                </h3>
                <p class="dpx-entry-card__description">{entry.data.description}</p>
                <p class="dpx-entry-card__meta">
                  {pages.guidesIndex.reviewedLabel}{' '}
                  <time datetime={entry.data.reviewedAt}>{entry.data.reviewedAt}</time>
                </p>
              </Card>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {/* 12. Restrained affiliate module — OMITTED. See the docblock at the top of this file. */}

  {
    /* A single provenance chip, so the homepage itself declares what its demo panels are.
       Belt and braces beside the cockpit's own chips: this page shows a result, and a result
       without a label is the thing AGENTS.md §1.2 exists to prevent. */
  }
  <p class="dpx-shell dpx-lookup__note">
    <ProvenanceChip kind="demo" freshness={cockpit.demoCaption} />
  </p>
</BaseLayout>

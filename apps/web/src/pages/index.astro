---
/**
 * Minimal homepage.
 *
 * The full homepage in DIRECTIVE.md section 18.3 — hero lookup, demo result, connection-risk and
 * passenger-rights explainers, pricing, source strip — is Phase 10 and belongs to
 * frontend-ui-engineer. This page carries only statements that are true today: what DelayPilot is,
 * how it treats uncertainty, and the independence disclaimer required by AGENTS.md section 1.4.
 *
 * It deliberately contains no call-to-action control, because the flight lookup it would open does
 * not exist yet, and a control that does nothing is a dead control (AGENTS.md section 1.6).
 */
const title = 'DelayPilot — Stay ahead of flight disruptions'
const description =
  'Track a flight, understand connection risk, and see the refund, care, and rebooking rules that may apply.'

/**
 * A canonical URL and an og:url need an absolute origin. That origin comes from
 * PUBLIC_SITE_URL through `site` in astro.config.mjs, which is deliberately left undefined
 * until a real domain is configured. When it is absent these two tags are omitted entirely
 * rather than emitted against an example or guessed origin: a canonical pointing at the
 * wrong host is worse than no canonical, and inventing one would be exactly the kind of
 * fabricated value AGENTS.md §1.1 forbids.
 *
 * The origin-independent tags below always ship, because they are true regardless of where
 * the site is served from.
 *
 * Owner note: the full metadata system — title templates, per-route canonicals, structured
 * data, sitemap — is seo-engineer's in Phase 11 (DIRECTIVE.md §19). This is the homepage
 * baseline only, added under direct owner instruction after an external audit found no
 * canonical, Open Graph, or Twitter tags anywhere in the build.
 */
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DelayPilot" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    {
      /* summary, not summary_large_image: no og:image ships until a real social card exists.
        A card tag promising an image that 404s is a dead reference (AGENTS.md §1.6). */
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="data:," />
  </head>
  <body>
    <header>
      <p><strong>DelayPilot</strong></p>
    </header>

    <main>
      <h1>Stay ahead of flight disruptions.</h1>

      <p>
        Track a flight, understand connection risk, and see the refund, care, and rebooking rules
        that may apply—before airport chaos makes the decision for you.
      </p>

      <p>Source-linked status · Versioned passenger-rights rules · No booking code required</p>

      <h2>How this site handles uncertainty</h2>

      <p>
        Every piece of flight information DelayPilot shows carries where it came from and how old it
        is. When no trustworthy source has answered, the answer is <em>unknown</em>, and it says so
        rather than filling the gap. Passenger-rights guidance is an informational estimate tied to
        a dated, versioned rule set with links to the official source — not a determination, and not
        legal advice.
      </p>
    </main>

    <footer>
      <p>
        DelayPilot is an independent travel-information tool. It is not an airline, airport,
        government agency, law firm, claims company, or flight-data provider. Guidance is
        informational and may not reflect every fact in your case.
      </p>
    </footer>
  </body>
</html>

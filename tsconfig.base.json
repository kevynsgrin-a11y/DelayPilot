{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Owner: principal-architect. Every package tsconfig extends this. AGENTS.md §3.1 requires all eight strict flags below; relaxing one in a downstream tsconfig is a release-blocking defect.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // AGENTS.md §3.1 — the eight mandatory flags. Relaxing one downstream is a
    // release-blocking defect.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,

    // Not mandated by AGENTS.md, but dead code hides unfinished work.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  }
}
